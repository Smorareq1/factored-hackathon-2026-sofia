# Copiar a `.env` en la raíz y completar. `.env` está en .gitignore (CON-03): nunca subir valores reales.
# docker compose lo lee con `--env-file .env` (el Makefile ya lo pasa).

# --- LLM (AG) ---
GEMINI_API_KEY=
# Versión exacta de Gemini Flash; se registra en cada traza (§9.6). Vacío = gemini-3.5-flash
GEMINI_MODEL=
# Modelos de respaldo (coma) si el principal da 503/429/timeout; cada uno tiene su propia cuota en el free tier.
# Vacío = gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash · "none" = solo GEMINI_MODEL (eval reproducible)
GEMINI_FALLBACK_MODELS=
# Razonamiento de Gemini 3: low (defecto; minimal clasifica peor) · medium · high · default (el del modelo)
GEMINI_THINKING_LEVEL=
# MET-06: supuesto de precio USD por millón de tokens (vacío = 0.30 / 2.50)
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
# auto = Gemini si hay API key · rules = sin LLM (reglas + plantillas, útil sin cuota)
SOFIA_LLM_MODE=

# --- Agente (AG) ---
# Vacío = banco falso en proceso del agente. Con el stub de SIM: http://bank-api:8000
BANK_API_URL=

# --- Datos S3 (OPS) — credenciales del PDF del Data Dictionary ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=

# --- Langfuse ---
# Con `make langfuse` (self-hosted local) los defaults del compose ya funcionan:
#   UI http://localhost:3100 · usuario dev@sofia.local · clave sofia-local
# Para Langfuse cloud, completar host y llaves reales (infra/cloudrun/deploy.sh las sube a Secret Manager):
#   LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Cloud Run (OPS) ---
# Postgres de la nube (Neon) para el checkpointer del agente. Vacío = conversaciones en memoria, 1 instancia.
DATABASE_URL_CLOUD=
# Clave de /admin/* y /session/test de bank-api en la nube (header X-Admin-Key). Vacío = cerradas (403).
# El harness la manda si se define aquí; deploy.sh la sube a Secret Manager (admin-api-key).
ADMIN_API_KEY=

# --- Postgres local (checkpointer del agente, API bancaria, Langfuse) ---
POSTGRES_USER=sofia
POSTGRES_PASSWORD=sofia
POSTGRES_PORT=5433

# --- Jupyter (DS) ---
JUPYTER_TOKEN=sofia
