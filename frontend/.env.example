# Solo para `npm run dev` fuera de Docker (copiar a .env.local). En compose ya vienen seteadas.
# El navegador habla solo con el agente, que hace de BFF hacia la API bancaria de SIM.
NEXT_PUBLIC_AGENT_URL=http://localhost:8001
NEXT_PUBLIC_LANGFUSE_URL=http://localhost:3100
# Segmento /project/<id>/traces. Local: sofia-local. En cloud, el id del proyecto de Langfuse.
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=sofia-local
