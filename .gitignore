!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
data/**/*.parquet
data/**/*.csv
data/**/*.tsv
data/**/*.jsonl
*.parquet
*.duckdb
*.duckdb.wal
*.duckdb.tmp

