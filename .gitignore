ml/artifacts/
ml/models/
ml/outputs/
ml/cache/
*.joblib
*.pkl
*.pickle
*.pt
*.onnx
**/.cache/

# --- Corridas del harness (eval/). Los casos JSON de §9.5 sí se versionan ---
eval/outputs/
eval/runs/
eval/cache/

# --- Checkpoints locales de LangGraph (agent/) ---
agent/**/*.sqlite
agent/**/*.sqlite3
**/.langgraph_api/

# --- Frontend Next.js (frontend/) ---
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
.eslintcache
npm-debug.log*
yarn-debug.log*
