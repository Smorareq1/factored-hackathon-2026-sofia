# S.O.F.I.A. — stack: Python, FastAPI, LangGraph, Gemini, DuckDB/Parquet/Polars,
# Next.js, Langfuse, Cloud Run.
# CON-03: ni secretos ni registros de clientes en el repo. Los datos se regeneran con `make data`.

# --- Brief interno ---
docs/requirements/*

# --- Planes personales por integrante (no se versionan) ---
docs/plans/sebas/*

# --- Secretos (CON-03). .env.example sí se versiona, sin valores reales ---
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*credentials*.json
*service-account*.json
*serviceAccount*.json
application_default_credentials.json
.aws/
secrets/

# --- Python: services/, agent/, ml/, data/, eval/, analysis/, contracts/ ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/
pip-log.txt
pip-delete-this-directory.txt

# --- Notebooks (analysis/) ---
.ipynb_checkpoints/

# --- Lakehouse local. El código del pipeline sí se versiona ---
data/raw/**
data/bronze/**
data/silver/**
data/gold/**
data/cache/**
